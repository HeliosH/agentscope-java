# This file starts an independent integration-test service. It is not loaded by the Java app.
LF_AUTH_TOKEN=CHANGE_ME_TO_A_RANDOM_TOKEN
LLAMA_FIREWALL_HTTP_PORT=18082
LLAMA_FIREWALL_VERSION=1.0.3
TORCH_VERSION=2.4.1
TRANSFORMERS_VERSION=4.57.3
LF_MAX_CONCURRENT_REQUESTS=4
LF_USER_INPUT_SCANNERS=hidden_ascii,regex
LF_TOOL_REQUEST_SCANNERS=code_shield,hidden_ascii,regex
LF_TOOL_RESULT_SCANNERS=hidden_ascii,regex
LF_ASSISTANT_OUTPUT_SCANNERS=code_shield,regex
